default_platform(:ios)

platform :ios do
  desc "Upload a production build to TestFlight internal testing"
  lane :internal do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_PATH")
    )

    match(type: "appstore", readonly: true, api_key: api_key)

    workspace = Dir[File.expand_path("../ios/*.xcworkspace")].first
    UI.user_error!("No generated iOS workspace found") unless workspace
    scheme = ENV.fetch("IOS_SCHEME", File.basename(workspace, ".xcworkspace"))
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    update_code_signing_settings(
      path: workspace.sub(/\.xcworkspace\z/, ".xcodeproj"),
      use_automatic_signing: false,
      targets: [scheme],
      team_id: ENV.fetch("APPLE_DEVELOPER_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: ENV.fetch("sigh_#{app_identifier}_appstore_profile-name")
    )

    build_app(
      workspace: workspace,
      scheme: scheme,
      clean: true,
      export_method: "app-store",
      output_directory: "artifacts/ios",
      output_name: "RozliczKorki.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "artifacts/ios/RozliczKorki.ipa",
      distribute_external: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: true
    )
  end
end
