{
  "expo": {
    "name": "RozliczKorki",
    "slug": "rozliczkorki",
    "version": "1.0.0",
    "scheme": "rozliczkorki",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b10",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b10"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.rozliczkorki.app",
      "associatedDomains": ["webcredentials:rozliczkorki.pl"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b10"
      },
      "package": "pl.rozliczkorki.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-web-browser",
      "./plugins/withAndroidReleaseSigning"
    ]
  }
}
