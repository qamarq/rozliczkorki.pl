{
  "expo": {
    "name": "RozliczKorki",
    "slug": "rozliczkorki",
    "version": "1.0.15",
    "scheme": "rozliczkorki",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111827",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.rozliczkorki.app",
      "appleTeamId": "KWQW4NSRZ4",
      "usesAppleSignIn": true,
      "associatedDomains": ["webcredentials:rozliczkorki.pl", "applinks:rozliczkorki.pl"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "package": "pl.rozliczkorki.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "rozliczkorki.pl",
              "pathPrefix": "/dashboard"
            },
            {
              "scheme": "https",
              "host": "rozliczkorki.pl",
              "pathPrefix": "/lesson"
            }
          ]
        }
      ],
      "versionCode": 11,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.POST_PROMOTED_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1"
        }
      ],
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/withAndroidR8Optimization",
      [
        "./plugins/withAndroidAssetStatements",
        {
          "domains": ["rozliczkorki.pl"]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "pl.rozliczkorki.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.pl.rozliczkorki.app"
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withIosAppleSignIn",
      "./plugins/withAndroidEdgeToEdge",
      [
        "expo-live-updates",
        {
          "channelId": "lesson-live",
          "channelName": "Trwające zajęcia"
        }
      ]
    ]
  }
}
