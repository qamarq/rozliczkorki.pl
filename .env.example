# Template for local env files. There are two, read by different tools:
#
#   apps/web/.env.local  — loaded by Next.js (dev/build). Everything the running
#                          server needs: auth, db, Resend, cron. Next.js does NOT
#                          read this root file, so new server vars go there.
#   .env (this folder)   — only used by the drizzle-kit scripts in packages/db
#                          (`dotenv -e ../../.env -- drizzle-kit ...`). Needs
#                          DATABASE_URL; the rest is unused there.
#
# On Vercel, set the apps/web vars in the project's environment settings.

DATABASE_URL=postgres://rozliczkorki:rozliczkorki@localhost:5434/rozliczkorki

BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-string
BETTER_AUTH_URL=http://localhost:3000

TRUSTED_ORIGINS=rozliczkorki://

# Google OAuth (leave empty to disable "Zaloguj przez Google")
GOOGLE_CLIENT_ID=304685809504-k88qr5pt109j9u32norqg15bnjnik5j7.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

EXPO_PUBLIC_API_URL=http://localhost:3000

CRON_SECRET=change-me

# Resend — transactional email (verification + password reset).
# Leave empty in dev: emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="RozliczKorki <noreply@rozliczkorki.pl>"

# Distinct cookie prefix, so localhost cookies don't clash with other local apps.
AUTH_COOKIE_PREFIX=korkomat
